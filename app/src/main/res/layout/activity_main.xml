<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
    <androidx.camera.view.PreviewView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="match_parent"/>
    <com.hoopai.app.PoseOverlayView android:id="@+id/poseOverlay" android:layout_width="match_parent" android:layout_height="match_parent"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp" android:background="#99000000">
        <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HoopAI • تحلیل تمرین" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="در حال آماده‌سازی AI..." android:textColor="#FFFFFF" android:textSize="15sp"/>
        <TextView android:id="@+id/metrics" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="اعتماد: --   نقاط بدن: --" android:textColor="#DDFFFFFF" android:textSize="13sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="horizontal" android:gravity="center" android:padding="10dp" android:background="#AA000000">
        <Button android:id="@+id/shooting" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="شوتینگ"/>
        <Button android:id="@+id/dribbling" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="دریبل"/>
        <Button android:id="@+id/defense" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="دفاع"/>
        <Button android:id="@+id/finishing" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="فینیشینگ"/>
        <Button android:id="@+id/switchCamera" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↻"/>
    </LinearLayout>
</FrameLayout>