<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="match_parent"
        android:keepScreenOn="true" />

    <com.hoopai.app.PoseOverlayView
        android:id="@+id/poseOverlay" android:layout_width="match_parent" android:layout_height="match_parent"
        android:clickable="false" android:focusable="false" />

    <LinearLayout
        android:id="@+id/topPanel"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|start" android:layout_marginStart="18dp" android:layout_marginTop="14dp"
        android:orientation="vertical" android:paddingStart="18dp" android:paddingTop="13dp"
        android:paddingEnd="18dp" android:paddingBottom="13dp" android:background="@drawable/hoopai_panel">
        <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="HoopAI  •  تحلیل تمرین" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="در حال آماده‌سازی AI..." android:textColor="#F3F4F6" android:textSize="14sp" />
        <TextView android:id="@+id/metrics" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:text="اعتماد: --   دریبل موفق: 0" android:textColor="#FFFFFF"
            android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/exerciseBar"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginBottom="14dp"
        android:orientation="horizontal" android:gravity="center" android:padding="9dp"
        android:background="@drawable/hoopai_menu_panel" android:elevation="12dp">

        <Button android:id="@+id/shooting" style="@style/HoopExerciseButton"
            android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
            android:text="شوتینگ" android:clickable="true" android:focusable="true" />

        <Button android:id="@+id/dribbling" style="@style/HoopExerciseButton"
            android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
            android:layout_marginStart="8dp" android:text="دریبلینگ" android:clickable="true" android:focusable="true" />

        <Button android:id="@+id/defense" style="@style/HoopExerciseButton"
            android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
            android:layout_marginStart="8dp" android:text="دفاع" android:clickable="true" android:focusable="true" />

        <Button android:id="@+id/finishing" style="@style/HoopExerciseButton"
            android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
            android:layout_marginStart="8dp" android:text="فینیشینگ" android:clickable="true" android:focusable="true" />

        <Button android:id="@+id/switchCamera" style="@style/HoopExerciseButton"
            android:layout_width="58dp" android:layout_height="52dp" android:layout_marginStart="8dp"
            android:text="↻" android:textSize="22sp" android:clickable="true" android:focusable="true" />
    </LinearLayout>
</FrameLayout>