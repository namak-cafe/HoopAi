<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0B0D12">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="match_parent"
        android:keepScreenOn="true" android:visibility="gone" />

    <com.hoopai.app.PoseOverlayView
        android:id="@+id/poseOverlay" android:layout_width="match_parent" android:layout_height="match_parent"
        android:clickable="false" android:focusable="false" android:visibility="gone" />

    <LinearLayout
        android:id="@+id/mainMenu"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp"
        android:paddingTop="18dp" android:paddingBottom="14dp" android:background="#0B0D12">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="HoopAI" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="مربی هوشمند بسکتبال تو" android:textColor="#AEB5C2" android:textSize="14sp"/>
            </LinearLayout>
            <TextView android:id="@+id/profileChip" android:layout_width="wrap_content" android:layout_height="44dp"
                android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp"
                android:text="پروفایل  •  سطح 1" android:textColor="#FFFFFF" android:textStyle="bold"
                android:background="@drawable/menu_chip"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="12dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="18dp"
            android:background="@drawable/menu_progress">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="برنامه امروز" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="آماده‌ای تمرین امروزت رو شروع کنی؟" android:textColor="#C5CAD4" android:textSize="12sp"/>
            </LinearLayout>
            <TextView android:id="@+id/dailyProgress" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0 / 55 دقیقه" android:textColor="#FFB45C" android:textSize="17sp" android:textStyle="bold"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="تمرین‌ها" android:textColor="#FFFFFF" android:textSize="19sp" android:textStyle="bold"/>

        <GridLayout
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="8dp" android:columnCount="3" android:rowCount="2"
            android:useDefaultMargins="false">

            <TextView android:id="@+id/menuShooting" android:layout_width="0dp" android:layout_height="0dp"
                android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="5dp"
                android:gravity="center" android:text="🏀
شوتینگ
فرم + دقت" android:textAlignment="center"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                android:background="@drawable/card_orange" android:clickable="true" android:focusable="true"/>

            <TextView android:id="@+id/menuDribbling" android:layout_width="0dp" android:layout_height="0dp"
                android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="5dp"
                android:gravity="center" android:text="🟣
دریبلینگ
کنترل + ریتم" android:textAlignment="center"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                android:background="@drawable/card_purple" android:clickable="true" android:focusable="true"/>

            <TextView android:id="@+id/menuDefense" android:layout_width="0dp" android:layout_height="0dp"
                android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="5dp"
                android:gravity="center" android:text="🛡️
دفاع
استنس + حرکت" android:textAlignment="center"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                android:background="@drawable/card_blue" android:clickable="true" android:focusable="true"/>

            <TextView android:id="@+id/menuFootwork" android:layout_width="0dp" android:layout_height="0dp"
                android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="5dp"
                android:gravity="center" android:text="⚡
فوت‌ورک
تعادل + سرعت" android:textAlignment="center"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                android:background="@drawable/card_green" android:clickable="true" android:focusable="true"/>

            <TextView android:id="@+id/menuFinishing" android:layout_width="0dp" android:layout_height="0dp"
                android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="5dp"
                android:gravity="center" android:text="🔥
فینیشینگ
قدم‌ها + پایان" android:textAlignment="center"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                android:background="@drawable/card_red" android:clickable="true" android:focusable="true"/>

            <TextView android:id="@+id/menuStats" android:layout_width="0dp" android:layout_height="0dp"
                android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="5dp"
                android:gravity="center" android:text="📊
آمار من
XP + رکوردها" android:textAlignment="center"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                android:background="@drawable/card_gold" android:clickable="true" android:focusable="true"/>
        </GridLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="🏆 XP امروز  •  0" android:textColor="#D9DEE7" android:textSize="14sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="44dp" android:gravity="center"
                android:paddingStart="24dp" android:paddingEnd="24dp" android:text="شروع تمرین  ›"
                android:textColor="#111111" android:textSize="15sp" android:textStyle="bold"
                android:background="@drawable/start_button" android:clickable="true" android:focusable="true"
                android:id="@+id/startExercise"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/categoryMenu"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp"
        android:paddingTop="18dp" android:paddingBottom="14dp" android:background="#0B0D12"
        android:visibility="gone">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <Button android:id="@+id/categoryBack" android:layout_width="52dp" android:layout_height="46dp"
                android:text="‹" android:textSize="24sp" android:textColor="#FFFFFF" android:background="@drawable/menu_chip"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/categoryTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="شوتینگ" android:textColor="#FFFFFF" android:textSize="25sp" android:textStyle="bold"/>
                <TextView android:id="@+id/categorySubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="تمرین‌های تخصصی این شاخه" android:textColor="#AEB5C2" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:layout_width="52dp" android:layout_height="46dp" android:gravity="center"
                android:text="AI" android:textColor="#111111" android:textStyle="bold" android:background="@drawable/start_button"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="18dp" android:orientation="vertical">

            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:layout_marginBottom="8dp" android:padding="16dp" android:orientation="horizontal"
                android:gravity="center_vertical" android:background="@drawable/menu_card">
                <TextView android:layout_width="64dp" android:layout_height="64dp" android:gravity="center"
                    android:text="🎯" android:textSize="30sp" android:background="@drawable/card_orange"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                    <TextView android:id="@+id/exerciseName1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="فرم شوت" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/exerciseDesc1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="پا، تعادل، آرنج و رهاسازی" android:textColor="#AEB5C2" android:textSize="12sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                        android:text="AI ANALYSIS  •  دوربین" android:textColor="#FFB45C" android:textSize="10sp" android:textStyle="bold"/>
                </LinearLayout>
                <TextView android:id="@+id/exerciseStart1" android:layout_width="88dp" android:layout_height="42dp" android:gravity="center"
                    android:text="شروع  ›" android:textColor="#111111" android:textStyle="bold" android:background="@drawable/start_button"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:layout_marginBottom="8dp" android:padding="16dp" android:orientation="horizontal"
                android:gravity="center_vertical" android:background="@drawable/menu_card">
                <TextView android:layout_width="64dp" android:layout_height="64dp" android:gravity="center"
                    android:text="🏀" android:textSize="30sp" android:background="@drawable/card_purple"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                    <TextView android:id="@+id/exerciseName2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="تمرین اصلی" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/exerciseDesc2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="تکرار واقعی با شمارش هوشمند" android:textColor="#AEB5C2" android:textSize="12sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                        android:text="AI ANALYSIS  •  شمارش" android:textColor="#A996FF" android:textSize="10sp" android:textStyle="bold"/>
                </LinearLayout>
                <TextView android:id="@+id/exerciseStart2" android:layout_width="88dp" android:layout_height="42dp" android:gravity="center"
                    android:text="شروع  ›" android:textColor="#111111" android:textStyle="bold" android:background="@drawable/start_button"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:padding="16dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/menu_card">
                <TextView android:layout_width="64dp" android:layout_height="64dp" android:gravity="center"
                    android:text="⚡" android:textSize="30sp" android:background="@drawable/card_green"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                    <TextView android:id="@+id/exerciseName3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="چالش AI" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/exerciseDesc3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="سرعت، ریتم و کیفیت حرکت" android:textColor="#AEB5C2" android:textSize="12sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                        android:text="AI ANALYSIS  •  امتیاز" android:textColor="#65E2B3" android:textSize="10sp" android:textStyle="bold"/>
                </LinearLayout>
                <TextView android:id="@+id/exerciseStart3" android:layout_width="88dp" android:layout_height="42dp" android:gravity="center"
                    android:text="شروع  ›" android:textColor="#111111" android:textStyle="bold" android:background="@drawable/start_button"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:id="@+id/cameraUi" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">

        <LinearLayout android:id="@+id/topPanel" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:layout_marginTop="14dp" android:orientation="vertical"
            android:padding="14dp" android:background="@drawable/hoopai_panel">
            <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="HoopAI  •  تحلیل تمرین" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
            <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="در حال آماده‌سازی AI..." android:textColor="#F3F4F6" android:textSize="14sp"/>
            <TextView android:id="@+id/metrics" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:text="اعتماد: --   دریبل موفق: 0" android:textColor="#FFFFFF"
                android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>

        <com.hoopai.app.FeedbackOverlayView android:id="@+id/feedbackOverlay"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clickable="false" android:focusable="false"/>
        <LinearLayout android:id="@+id/exerciseBar" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="bottom" android:layout_margin="14dp" android:orientation="horizontal" android:gravity="center" android:padding="9dp"
            android:background="@drawable/hoopai_menu_panel" android:elevation="12dp">
            <Button android:id="@+id/shooting" style="@style/HoopExerciseButton" android:layout_width="0dp" android:layout_height="52dp"
                android:layout_weight="1" android:text="شوتینگ"/>
            <Button android:id="@+id/dribbling" style="@style/HoopExerciseButton" android:layout_width="0dp" android:layout_height="52dp"
                android:layout_weight="1" android:layout_marginStart="8dp" android:text="دریبلینگ"/>
            <Button android:id="@+id/defense" style="@style/HoopExerciseButton" android:layout_width="0dp" android:layout_height="52dp"
                android:layout_weight="1" android:layout_marginStart="8dp" android:text="دفاع"/>
            <Button android:id="@+id/finishing" style="@style/HoopExerciseButton" android:layout_width="0dp" android:layout_height="52dp"
                android:layout_weight="1" android:layout_marginStart="8dp" android:text="فینیشینگ"/>
            <Button android:id="@+id/calibrateHoop" style="@style/HoopExerciseButton" android:layout_width="82dp" android:layout_height="52dp"
                android:layout_marginStart="8dp" android:text="🎯 حلقه"/>
            <Button android:id="@+id/switchCamera" style="@style/HoopExerciseButton" android:layout_width="58dp" android:layout_height="52dp"
                android:layout_marginStart="8dp" android:text="↻" android:textSize="22sp"/>
            <Button android:id="@+id/backMenu" style="@style/HoopExerciseButton" android:layout_width="70dp" android:layout_height="52dp"
                android:layout_marginStart="8dp" android:text="منو"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>